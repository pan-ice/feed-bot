{
  "manifest_version": 2,
  "id": "worldcopyist.meow-game-shop",
  "version": "2.3.0",
  "name": "Meow Game Shop",
  "description": "游戏商店喵喵喵（Meow Game Shop）— 签到积分+商店道具+投喂Bot+定时求投喂+小游戏，积分互通。",
  "author": {
    "name": "worldcopyist",
    "url": "https://github.com/worldcopyist"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/worldcopyist/feed-bot",
    "homepage": "https://github.com/worldcopyist/feed-bot",
    "documentation": "https://github.com/worldcopyist/feed-bot/blob/main/README.md",
    "issues": "https://github.com/worldcopyist/feed-bot/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "llm.generate",
    "chat.get_group_streams",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
